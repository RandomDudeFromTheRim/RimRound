<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- NOTICE (2026-11-15): three genes were removed from this file because they did nothing.
       RR_SlowMetabolism, RR_FastMetabolism and RR_NutrientStorage all advertised hunger-rate
       and weight-gain effects in customEffectDescriptions, but carried no statFactors,
       statOffsets, geneClass or forcedTraits - so a carrier got exactly nothing. Their shared
       exclusionTag "MetabolismRate" is not a StatDef anywhere in vanilla either, and zero
       vanilla genes use it, so they did not even exclude each other. Do not re-add them
       without a mechanism:
         - there is no weight-gain StatDef in RimRound to target (it is driven by settings,
           perks and the FullnessAndDietStats comp, not a stat), and
         - there is no hunger StatDef in this install at all (only RaceProperties.baseHungerRate).
       The working equivalent already ships in the bundled SwellGlow sub-mod: SG_GeneWeightUp and
       SG_GeneWeightUpPlus force SG_TraitWeightGainUp/Down, whose weight effect comes from
       SwellGlow.dll's SGTraitStatExtension. RimRound's copies were also labelled identically
       ("slow metabolism"), so two same-named genes loaded at once. -->

  <!-- Dense Bones: extra blunt armor, minor move penalty. Synergizes with weight armor -->
  <GeneDef>
    <defName>RR_DenseBones</defName>
    <label>dense bones</label>
    <labelShortAdj>dense-boned</labelShortAdj>
    <description>Carriers of this gene have unusually dense, heavy bones. This provides natural protection against blunt force, but makes the carrier heavier and slightly slower. The protection stacks with natural body mass, making larger carriers exceptionally durable.</description>
    <iconPath>UI/Icons/Genes/Gene_StrongImmunity</iconPath>
    <displayOrderInCategory>9997</displayOrderInCategory>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <statOffsets>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <MoveSpeed>-0.10</MoveSpeed>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <customEffectDescriptions>
      <li>+10% blunt armor</li>
      <li>-0.10 move speed</li>
    </customEffectDescriptions>
  </GeneDef>

  <!-- Calorie Dumping: temperature tolerance only. This gene used to promise "Weight gain -30%
       from meals" as well; there is no hook to implement that with, so the claim is gone rather
       than left lying to the player. If a weight stat is ever added to RimRound, this is where
       that effect belongs. -->
  <GeneDef>
    <defName>RR_CalorieDumping</defName>
    <label>calorie dumping</label>
    <labelShortAdj>calorie-dumping</labelShortAdj>
    <description>Carriers of this gene can consciously dump excess calories as body heat. This makes them resistant to cold environments but causes them to overheat faster in warm climates.</description>
    <iconPath>UI/Icons/Genes/Gene_ColdRelaxed</iconPath>
    <displayOrderInCategory>9996</displayOrderInCategory>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <statOffsets>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>-8</ComfyTemperatureMax>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <customEffectDescriptions>
      <li>Cold tolerance +10°C</li>
      <li>Heat tolerance -8°C</li>
    </customEffectDescriptions>
  </GeneDef>
</Defs>
