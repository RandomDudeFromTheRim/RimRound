<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>RR_MeldAerosol</defName>
    <label>meld aerosol infection</label>
    <description>A bioweapon aerosol that forces rapid meld growth in living tissue. The body is being consumed from within. At full saturation the host detonates into a cluster of blob walls.</description>
    <hediffClass>RimRound.Hediffs.Hediff_MeldAerosol</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>itching</label>
        <partEfficiencyOffset>-0.02</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.34</minSeverity>
        <label>growing</label>
        <partEfficiencyOffset>-0.05</partEfficiencyOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.67</minSeverity>
        <label>consuming</label>
        <partEfficiencyOffset>-0.15</partEfficiencyOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.25</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
          <li><capacity>Eating</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
