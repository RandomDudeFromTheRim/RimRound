<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>RR_BloatedDeathAffliction</defName>
    <label>bloated death affliction</label>
    <description>The victim of a bloated corpse explosion, suffering severe internal damage and unnatural growth.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li>
        <compClass>HediffComp_Disappears</compClass>
        <disappearsAfterTicks>120000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.0</minSeverity>
        <label>strained</label>
        <pain>0.10</pain>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>debilitated</label>
        <pain>0.25</pain>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <pain>0.40</pain>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.50</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
