<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RR_BlobWall</defName>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <label>blob wall</label>
    <description>A pulsating wall of organic matter. Warm and slightly moist to the touch. It throbs gently, as if breathing.</description>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <stuffCategories />
    <graphicData>
      <texPath>WIP/Skin_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Custom2</li>
      </linkFlags>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>false</coversFloor>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <fertility>0</fertility>
    <drawerType>MapMeshAndRealTime</drawerType>
    <filthLeaving>Filth_Fleshmass</filthLeaving>
    <soundImpactDefault>Fleshmass_Damaged</soundImpactDefault>
    <autoTargetNearbyIdenticalThings>true</autoTargetNearbyIdenticalThings>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <Beauty>-6</Beauty>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <destroyEffecter>FleshmassDestroyed</destroyEffecter>
      <destroyShakeAmount>0</destroyShakeAmount>
      <quickTargetable>true</quickTargetable>
    </building>
    <comps>
      <li Class="RimRound.Comps.CompProperties_GluttoniumRadiation">
        <radius>2.5</radius>
        <exposurePerTick>0.006</exposurePerTick>
        <tickInterval>350</tickInterval>
      </li>
      <li Class="RimRound.Comps.CompProperties_DestroyDrop">
        <dropDefName>Meat_Twisted</dropDefName>
        <dropCount>5</dropCount>
      </li>
      <!-- cutting into bloated mass lets out a puff of bloatgas -->
      <li Class="RimRound.Comps.CompProperties_GasOnDestroy">
        <radius>1.5</radius>
        <gasPerCell>110</gasPerCell>
      </li>
    </comps>
  </ThingDef>

  <!-- Mineable blob wall that drops void gluttonium. Based on vanilla's mineable
       rock (RockBase) so it is a proper selectable, linking building. -->
  <ThingDef ParentName="RockBase">
    <defName>RR_BlobWallMineable</defName>
    <label>void blob wall</label>
    <description>A thicker, vein-ridden section of blob wall. Pulses with a purple glow. Can be mined for void gluttonium.</description>
    <!-- Linked atlases for the flesh dimension walls: all share Custom2 with the blob
         wall so the maze reads as one continuous mass. Made by Source/TextureGen. -->
    <graphicData>
      <texPath>Things/Building/FleshDimension/RR_VoidBlobWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags Inherit="False">
        <li>Custom2</li>
      </linkFlags>
    </graphicData>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isResourceRock>true</isResourceRock>
      <claimable>false</claimable>
      <mineableThing>RR_VoidGluttonium</mineableThing>
      <mineableYield>2</mineableYield>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(180,40,180,0)</glowColor>
      </li>
      <li Class="RimRound.Comps.CompProperties_GluttoniumRadiation">
        <radius>4</radius>
        <exposurePerTick>0.015</exposurePerTick>
        <tickInterval>200</tickInterval>
      </li>
      <li Class="RimRound.Comps.CompProperties_GasOnDestroy">
        <radius>2.9</radius>
        <gasPerCell>200</gasPerCell>
      </li>
    </comps>
  </ThingDef>

  <!-- Crimson flesh wall variant sprinkled through the maze -->
  <ThingDef ParentName="BuildingBase">
    <defName>RR_FleshWall</defName>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <label>flesh wall</label>
    <description>A dense wall of twisted crimson flesh. Veins branch across its surface and something moves underneath.</description>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <stuffCategories />
    <graphicData>
      <texPath>Things/Building/FleshDimension/RR_FleshWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Custom2</li>
      </linkFlags>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>false</coversFloor>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <fertility>0</fertility>
    <drawerType>MapMeshAndRealTime</drawerType>
    <filthLeaving>Filth_GrayFlesh</filthLeaving>
    <soundImpactDefault>Fleshmass_Damaged</soundImpactDefault>
    <autoTargetNearbyIdenticalThings>true</autoTargetNearbyIdenticalThings>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.9</Flammability>
      <Beauty>-8</Beauty>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <destroyEffecter>FleshmassDestroyed</destroyEffecter>
      <destroyShakeAmount>0</destroyShakeAmount>
      <quickTargetable>true</quickTargetable>
    </building>
    <comps>
      <li Class="RimRound.Comps.CompProperties_DestroyDrop">
        <dropDefName>Meat_Twisted</dropDefName>
        <dropCount>3</dropCount>
      </li>
      <li Class="RimRound.Comps.CompProperties_GasOnDestroy" />
    </comps>
  </ThingDef>

  <!-- Hardened flesh shell: the maze's immovable outer carcass -->
  <ThingDef ParentName="BuildingBase">
    <defName>RR_HardenedFleshWall</defName>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <label>hardened flesh</label>
    <description>Calloused, calcified flesh dense as bedrock. The skeleton of whatever vast organism this place grew inside of.</description>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <stuffCategories />
    <graphicData>
      <texPath>Things/Building/FleshDimension/RR_HardenedFlesh_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Custom2</li>
        <li>MapEdge</li>
      </linkFlags>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>false</coversFloor>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <fertility>0</fertility>
    <drawerType>MapMeshAndRealTime</drawerType>
    <filthLeaving>Filth_GrayFlesh</filthLeaving>
    <soundImpactDefault>Fleshmass_Damaged</soundImpactDefault>
    <statBases>
      <MaxHitPoints>50000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <destroyShakeAmount>0</destroyShakeAmount>
      <quickTargetable>false</quickTargetable>
    </building>
  </ThingDef>

  <!-- Bloatgas geyser: a vent in the flesh dimension that swells with bloatgas
       (fattening gas) and erupts. Placed by GenStep_RRVoidMaze. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RR_BloatGeyser</defName>
    <thingClass>Building</thingClass>
    <label>bloatgas geyser</label>
    <description>A puckered vent in the living flesh. It slowly swells with sweet, heavy bloatgas and then erupts, flooding the area with gas that swells anyone who breathes it. It fills faster when something warm is close by - it seems to want an audience.

Pawns caught right on top of an eruption take the blast head-on: it soaks them in void saturation and leaves those who enjoy growing flushed and aching.</description>
    <graphicData>
      <texPath>Things/Building/FleshDimension/RR_BloatGeyser</texPath>
      <!-- breathes, like Anomaly's fleshmass organs -->
      <graphicClass>Graphic_Single_SquashNStretch</graphicClass>
      <shaderType>BuildingSquashNStretch</shaderType>
      <maxSnS>(.92, .95)</maxSnS>
      <offsetSnS>(.5, -.45)</offsetSnS>
      <drawSize>(1.8,1.8)</drawSize>
    </graphicData>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <tickerType>Normal</tickerType>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <statBases>
      <Beauty>-4</Beauty>
    </statBases>
    <comps>
      <li Class="RimRound.Comps.CompProperties_BloatGeyser">
        <warningSound>RR_StomachGurgles_Heavy</warningSound>
        <eruptSound>RR_StomachBurp_Heavy</eruptSound>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <glowColor>(230,90,170,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
</Defs>
