<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef>
    <defName>RR_VoidPortal</defName>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <label>void seam</label>
    <description>The ground has split open into a mouth. Something unimaginably large lies beneath the crust, and it has opened up to be fed. Warm, sweet breath rolls out of it, and flesh spreads across the ground around it for as long as it stays open.

Pawns who are Chubby or heavier can climb in, into the void maze: one long, living gut. The way home lies at its far end. Seal the seam and the flesh around it withers back.</description>
    <stuffCategories />
    <graphicData>
      <texPath>Things/Building/FleshDimension/RR_VoidSeam</texPath>
      <!-- breathes, like Anomaly's fleshmass organs -->
      <graphicClass>Graphic_Single_SquashNStretch</graphicClass>
      <shaderType>BuildingSquashNStretch</shaderType>
      <maxSnS>(.95, .9)</maxSnS>
      <offsetSnS>(.5, -.45)</offsetSnS>
      <drawSize>(4.5,4.5)</drawSize>
    </graphicData>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <!-- needed for Comp_VoidPortal.CompTick: maze timeout, fleshbeast spawns, cleanup -->
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <size>(1,1)</size>
    <comps>
      <li Class="RimRound.Comps.CompProperties_VoidPortal">
        <activateTexPath>UI/Activate/Activate</activateTexPath>
        <minWeightToEnter>0.09</minWeightToEnter>
        <mazeDurationTicks>45000</mazeDurationTicks> <!-- 18 in-game hours to walk the gut to the way home -->
        <respawnIntervalTicks>12000</respawnIntervalTicks>
        <maxMeldBeasts>4</maxMeldBeasts>
        <activateLabelString>Enter the void maze</activateLabelString>
        <jobString>entering the void maze</jobString>
      </li>
      <!-- flesh spreads over the ground around the seam while it is open, and
           withers back to the original ground when it is sealed -->
      <li Class="RimRound.Comps.CompProperties_FleshSpread">
        <maxRadius>7.9</maxRadius>
        <ticksToFullSpread>30000</ticksToFullSpread>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(180,40,180,0)</glowColor>
      </li>
      <li Class="CompProperties_Studiable" MayRequire="Ludeon.RimWorld.Anomaly">
        <frequencyTicks>120000</frequencyTicks>
        <knowledgeCategory>Advanced</knowledgeCategory>
        <anomalyKnowledge>1</anomalyKnowledge>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
      </li>
      <!-- studying the seam makes the runs through it easier (Comp_VoidPortal) -->
      <li Class="RimRound.Utilities.CompProperties_RRStudyPayoffs" MayRequire="Ludeon.RimWorld.Anomaly">
        <studyNotes>
          <li>
            <thresholdRange>2~3</thresholdRange>
            <label>Void seam study progress</label>
            <text>{PAWN_nameDef} has learned to read the seam's rhythm. Your pawns can now stay in the void maze a quarter longer before it pushes them out.</text>
          </li>
          <li>
            <thresholdRange>4~5</thresholdRange>
            <label>Void seam study progress</label>
            <text>{PAWN_nameDef} has noticed what stirs the maze's flesh into birthing fleshbeasts, and how to avoid it. Fleshbeasts will come for your pawns in the maze less often.</text>
          </li>
          <li>
            <thresholdRange>7~8</thresholdRange>
            <label>Void seam study complete</label>
            <text>{PAWN_nameDef} knows where the maze keeps its richest gluttonium. Pawns who reach the end of the maze now come home with half again as much.</text>
          </li>
        </studyNotes>
        <unlockKeys>
          <li>seam_1</li>
          <li>seam_2</li>
          <li>seam_3</li>
        </unlockKeys>
      </li>
    </comps>
    <building>
      <isInert>false</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <EntityCodexEntryDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>RR_VoidPortal</defName>
    <label>void seam</label>
    <useDescriptionFrom>RR_VoidPortal</useDescriptionFrom>
    <!-- codex entries also load <uiIconPath>_Silhouette; both are made by Source/TextureGen -->
    <uiIconPath>UI/CodexEntries/RR_VoidSeam</uiIconPath>
    <category>Advanced</category>
    <linkedThings>
      <li>RR_VoidPortal</li>
    </linkedThings>
    <orderInCategory>1500</orderInCategory>
  </EntityCodexEntryDef>
</Defs>
