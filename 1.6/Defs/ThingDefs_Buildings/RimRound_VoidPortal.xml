<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef>
    <defName>RR_VoidPortal</defName>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <label>void portal</label>
    <description>A pulsating vertical wound in reality. Warm, humid air wafts through it, carrying a sweet, heavy scent. Pawns with Chubby+ body types feel drawn to it... entering sends them into the void maze where weight grows freely, but fleshbeasts lurk in the warm dark.</description>
    <stuffCategories />
    <graphicData>
      <texPath>Things/Building/Misc/VoidPortal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <size>(1,1)</size>
    <comps>
      <li Class="RimRound.Comps.CompProperties_VoidPortal">
        <activateTexPath>UI/Activate/Activate</activateTexPath>
        <minWeightToEnter>0.09</minWeightToEnter>
        <mazeDurationTicks>120000</mazeDurationTicks>
        <respawnIntervalTicks>60000</respawnIntervalTicks>
        <maxMeldBeasts>4</maxMeldBeasts>
        <activateLabelString>Enter the void maze</activateLabelString>
        <jobString>entering the void maze</jobString>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(180,40,180,0)</glowColor>
      </li>
    </comps>
    <building>
      <isInert>false</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>
</Defs>
