<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Food Converter: bridges the VNPE paste pipe net and RimRound's density-aware liter FoodNet.
       Requires both a VNPE paste line/pipe and a RimRound feed line to connect to. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RR_FoodConverter</defName>
    <label>food converter</label>
    <description>Converts nutrient paste from the paste pipe network into dense liquid food for the feeding tube system — or back. Can adjust the nutrition density of the output. Place it so it touches both a nutrient paste pipe and a food tube line.</description>
    <thingClass>RimRound.FeedingTube.Building_FoodConverter</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/FoodRefiner</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.40</fillPercent>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <Mass>70</Mass>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>3600</WorkToBuild>
      <Flammability>0.7</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>60</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Forbiddable"/>
      <!-- VNPE paste net membership (VEF PipeSystem) -->
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VNPE_NutrientPasteNet</pipeNet>
      </li>
      <!-- RimRound legacy FoodNet membership (density-aware liters) -->
      <li Class="RimRound.FeedingTube.Comps.FoodNetTrader_CompProperties">
        <compClass>RimRound.FeedingTube.Comps.FoodNetTrader_ThingComp</compClass>
      </li>
    </comps>
    <placeWorkers>
      <li>RimRound.FeedingTube.FoodTransmitter_PlaceWorker</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc1</designationHotKey>
    <researchPrerequisites>
      <li>RR_Research_FoodFaucet</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
