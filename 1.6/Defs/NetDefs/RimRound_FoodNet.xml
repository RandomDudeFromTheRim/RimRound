<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Retired: liquid food now runs on the RimRound food conduit network. This net
       and its pipe/valve defs only remain so old saves load; the pipes are turned
       back into their build materials on load (SaveCompat_ConvertRetiredFoodPipes). -->
  <PipeSystem.PipeNetDef>
    <defName>RR_FoodNet</defName>
    <noStorageAlert>true</noStorageAlert>
    <resource>
      <name>Liquid food</name>
      <unit>units</unit>
      <color>(0.95, 0.90, 0.80)</color>
      <onlyShowStored>true</onlyShowStored>
      <offTexPath>Things/Item/Resource/Gluttonium/Gluttonium_a</offTexPath>
    </resource>
    <pipeDefs>
      <li>RR_FoodPipe</li>
      <li>RR_UndergroundFoodPipe</li>
    </pipeDefs>
    <overlayOptions>
      <overlayColor>(0.95, 0.90, 0.80)</overlayColor>
    </overlayOptions>
  </PipeSystem.PipeNetDef>
</Defs>
