<?xml version="1.0" encoding="utf-8" ?>
<!-- The fattening pirates (flab grenadiers, enbiggunners) were defined but no faction
     ever fielded them. Pirates now mix a few into their combat groups. -->
<Patch>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/FactionDef[defName="Pirate"]/pawnGroupMakers/li[kindDef="Combat"]/options</xpath>
    <value>
      <RREE_Pirate_Fattening_Gunner>3</RREE_Pirate_Fattening_Gunner>
      <RREE_Mercenary_Fattening_Gunner>2</RREE_Mercenary_Fattening_Gunner>
      <RREE_Grenadier_Fattening>2</RREE_Grenadier_Fattening>
    </value>
  </Operation>
</Patch>
