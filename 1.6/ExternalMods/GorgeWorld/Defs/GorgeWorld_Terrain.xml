    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>RR_GorgeFlesh</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RR_GelatinMire</defName>
    <label>gelatin mire</label>
    <description>Wet, wobbling gelatin, half set. Walking through it is slow, sucking work.</description>
    <texturePath>Terrain/RR_GelatinMire</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>330</renderPrecedence>
    <pathCost>14</pathCost>
    <fertility>0.5</fertility>
    <takeFootprints>true</takeFootprints>
    <avoidWander>true</avoidWander>
    <driesTo>RR_Tallow</driesTo>
    <statBases>
      <Beauty>-3</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>RR_GorgeFlesh</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="WaterShallowBase">
    <defName>RR_BloodMovingShallow</defName>
    <label>shallow blood stream</label>
    <description>A slow stream of warm blood, running through the flesh in an open vein. Ankle-deep.</description>
    <texturePath>Terrain/RR_BloodRamp</texturePath>
    <pollutedTexturePath>Terrain/RR_BloodRamp</pollutedTexturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <renderPrecedence>383</renderPrecedence>
    <canFreeze>false</canFreeze>
    <affordances>
      <li>MovingFluid</li>
    </affordances>
    <tags>
      <li>River</li>
      <li>RR_GorgeLiquid</li>
    </tags>
    <waterDepthShaderParameters>
      <_UseWaterOffset>1</_UseWaterOffset>
    </waterDepthShaderParameters>
  </TerrainDef>

