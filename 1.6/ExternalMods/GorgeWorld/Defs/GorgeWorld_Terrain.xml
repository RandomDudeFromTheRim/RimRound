<?xml version="1.0" encoding="utf-8" ?>
<!-- The Gorge World's ground: flesh, scar tissue, tallow and gelatin, with blood, molten
     tallow and bile where other worlds have water. No soil, no sand. Art: Source/TextureGen/gorgetex.py
     (living flesh reuses the flesh dimension's floor). -->
<Defs>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RR_GorgeFlesh</defName>
    <label>living flesh</label>
    <description>Warm, living flesh, the ground of the Gorge World. It dimples underfoot and slowly springs back, and things take root in it readily.</description>
    <texturePath>Terrain/RR_FleshFloor</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>345</renderPrecedence>
    <pathCost>2</pathCost>
    <fertility>1.0</fertility>
    <takeFootprints>true</takeFootprints>
    <statBases>
      <Beauty>-2</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>RR_GorgeFlesh</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RR_FleshVeined</defName>
    <label>veined flesh</label>
    <description>Living flesh thick with veins just under the skin. It's richer than the flesh around it, and things grow fat on it.</description>
    <texturePath>Terrain/RR_FleshVeined</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>346</renderPrecedence>
    <pathCost>2</pathCost>
    <fertility>1.3</fertility>
    <takeFootprints>true</takeFootprints>
    <statBases>
      <Beauty>-2</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>RR_GorgeFlesh</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RR_ScarTissue</defName>
    <label>scar tissue</label>
    <description>Pale, tight, dry flesh that has healed over and over again. Little grows in it.</description>
    <texturePath>Terrain/RR_ScarTissue</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>335</renderPrecedence>
