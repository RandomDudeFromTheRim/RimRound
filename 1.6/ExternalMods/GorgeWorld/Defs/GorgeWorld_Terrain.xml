    <statBases>
      <Beauty>-1</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>RR_GorgeFlesh</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RR_Tallow</defName>
    <label>tallow</label>
    <description>Rendered fat, set soft and waxy in the warmth. It gives a little underfoot and leaves a greasy sheen on everything.</description>
    <texturePath>Terrain/RR_Tallow</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>340</renderPrecedence>
    <pathCost>3</pathCost>
