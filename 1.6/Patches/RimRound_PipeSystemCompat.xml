<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Add PipeSystem comps to buildings whose C# now expects them -->
  <!-- These replace the old custom network comps (still in XML but unused by new code) -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_FeedingTubeFoodProcessor"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RR_FoodNet</pipeNet>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_FoodFaucet"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RR_FoodNet</pipeNet>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_NutrientDistillery"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RR_FoodNet</pipeNet>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_AutoFeeder"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RR_FoodNet</pipeNet>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_AdvancedAutoFeeder"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RR_FoodNet</pipeNet>
      </li>
    </value>
  </Operation>

  <!-- Add PipeSystem storage to old vat defs -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_FoodStorageVat_Small"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>RR_FoodNet</pipeNet>
        <storageCapacity>50</storageCapacity>
        <barSize>(0.5, 0.15)</barSize>
        <margin>0.05</margin>
        <centerOffset>(0, 0, -0.15)</centerOffset>
        <contentRequirePower>true</contentRequirePower>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_FoodStorageVat_Large"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>RR_FoodNet</pipeNet>
        <storageCapacity>200</storageCapacity>
        <barSize>(0.75, 0.2)</barSize>
        <margin>0.05</margin>
        <centerOffset>(0, 0, -0.3)</centerOffset>
        <contentRequirePower>true</contentRequirePower>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_TD_FoodStorageVat_Massive"]/comps</xpath>
    <value>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>RR_FoodNet</pipeNet>
        <storageCapacity>600</storageCapacity>
        <barSize>(1.0, 0.25)</barSize>
        <margin>0.05</margin>
        <centerOffset>(0, 0, -0.4)</centerOffset>
        <contentRequirePower>true</contentRequirePower>
      </li>
    </value>
  </Operation>
</Patch>
