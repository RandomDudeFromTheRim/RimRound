<?xml version="1.0" encoding="utf-8" ?>

<!-- Lactation Expansion: a heavier pawn holds more milk (StatPart_LactationCapacityByWeight) -->
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/StatDef[defName="SEX_LactationCapacity"]/parts</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/StatDef[defName="SEX_LactationCapacity"]/parts</xpath>
			<value>
				<li Class="RimRound.AI.StatPart_LactationCapacityByWeight"/>
			</value>
		</match>
	</Operation>
</Patch>
